# --- Privacy ---
# LOCAL_ONLY=1 keeps submissions on this host. Cloud providers (Anthropic,
# OpenAI) and remote Ollama are disabled even if their keys are set below.
# Only set LOCAL_ONLY=0 when processing content you are licensed to share
# with third-party APIs.
LOCAL_ONLY=1

# --- Local LLM (used when LOCAL_ONLY=1) ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# --- Cloud / remote providers (ignored unless LOCAL_ONLY=0) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_REMOTE_URL=https://simonmccallum.org.nz/llm/v1
# OLLAMA_REMOTE_API_KEY=your_ollama_remote_api_key_here
# OLLAMA_REMOTE_MODEL=qwen2.5:7b

# --- Server ---
FLASK_ENV=development
FLASK_DEBUG=1
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
