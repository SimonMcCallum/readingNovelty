# --- Privacy ---
# LOCAL_ONLY=1 keeps submissions on this host (or on a trusted institutional
# host, see TRUSTED_LLM_HOSTS). Cloud providers (Anthropic, OpenAI, Gemini)
# and remote Ollama are disabled even if their keys are set below.
# Only set LOCAL_ONLY=0 when processing content you are licensed to share
# with third-party APIs.
LOCAL_ONLY=1

# Hosts that count as "local" for privacy purposes even though they are not
# this machine, e.g. an Open WebUI run by your own university. Comma separated.
TRUSTED_LLM_HOSTS=openwebui.ecs.vuw.ac.nz

# Force a specific provider instead of "first reachable in discovery order".
# One of: ollama-local, openwebui, anthropic, openai, gemini, ollama-remote.
# LLM_PROVIDER=openwebui

# --- Local LLM: Ollama on this machine ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# --- Institutional LLM: Open WebUI (OpenAI-compatible API under /api) ---
# Create the key at Open WebUI -> Settings -> Account -> API Keys.
# Leave OPENWEBUI_MODEL unset to use the first model the key can see;
# `python llm_providers.py --models` lists them.
OPENWEBUI_URL=https://openwebui.ecs.vuw.ac.nz
# OPENWEBUI_API_KEY=your_openwebui_api_key_here
# OPENWEBUI_MODEL=qwen2.5:7b
# OPENWEBUI_TIMEOUT=120

# --- Local embeddings (sentence-transformers, always on this machine) ---
# Pick a model with `python embedding_models_cli.py list` (Hugging Face
# similarity ranking) and verify it with `... check <model>`. Changing the
# model invalidates existing corpora: rebuild them (POST /assignments/<id>/
# rebuild_index) or use a fresh CORPUS_DIR.
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cuda          # or cpu; default lets torch decide
# EMBEDDING_TRUST_REMOTE_CODE=0  # 1 for models whose card says trust_remote_code
# EMBEDDING_BATCH_SIZE=32

# --- Cloud / remote providers (ignored unless LOCAL_ONLY=0) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_REMOTE_URL=https://simonmccallum.org.nz/llm/v1
# OLLAMA_REMOTE_API_KEY=your_ollama_remote_api_key_here
# OLLAMA_REMOTE_MODEL=qwen2.5:7b

# --- Server ---
FLASK_ENV=development
FLASK_DEBUG=1
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
CORPUS_DIR=corpus
